# Mi Predict client — frontend environment
# Copy to .env.local and adjust for local development. NEVER commit real .env files.

# Base URL of the Mi Predict API (origin only — the services append /api paths).
# Local development backend:
VITE_API_URL=http://localhost:3000

# Cloudflare Pages production build override (set in the Pages dashboard,
# not in a committed file):
# VITE_API_URL=https://api.mipredict.com